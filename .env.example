# Bluedev GrantWriter — environment variables
# Bu dosya .gitignore'da ".env.example" olarak istisna; commit edilir.
# Gerçek değerler için kopyala: `cp .env.example .env` ve değerleri doldur.
# `.env` dosyası gitignore'da, asla commit edilmez.

# ───────────────────────────────────────
# Database (Supabase / lokal Postgres)
# ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bluedev
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ───────────────────────────────────────
# LLM sağlayıcılar
# ───────────────────────────────────────
# OpenAI — embeddings için (text-embedding-3-large, 3072 dim)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic — chat completion için (Opus 4.7 / Sonnet 4.6)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ───────────────────────────────────────
# Auth (Supabase JWT)
# ───────────────────────────────────────
# Production'da Supabase project settings → API → JWT Secret'tan al.
# Lokal dev için herhangi bir uzun string yeterli.
SUPABASE_JWT_SECRET=dev-secret-change-me-in-production
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# ───────────────────────────────────────
# Runtime
# ───────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
