APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000"]

# Optional — set as features land. Leave commented for now.
# DATABASE_URL=
# REDIS_URL=
# ANTHROPIC_API_KEY=                     # Bluedev-managed key (platform fallback)
# OPENAI_API_KEY=                        # Bluedev-managed key (platform fallback)
# SUPABASE_JWT_SECRET=
# LLM_MASTER_ENCRYPTION_KEY=             # 32-byte random key for BYOK pgcrypto envelope
# SUPABASE_URL=                          # https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=             # service_role JWT — Storage uploads, never exposed to client
# SUPABASE_STORAGE_BUCKET=exports
# CELERY_BROKER_URL=                     # defaults to REDIS_URL when unset
# CELERY_RESULT_BACKEND=                 # defaults to REDIS_URL when unset

# Test-only: pytest security suite reads TEST_DATABASE_URL when set; the
# RLS edge-case tests skip if it is missing.
# TEST_DATABASE_URL=postgresql://postgres:test@127.0.0.1:55432/postgres
