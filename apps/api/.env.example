# apps/api için environment variables.
# Pydantic Settings (src/core/config.py) bu dosyayı otomatik okur.
# Gerçek değerler için: `cp .env.example .env` ve değerleri doldur.
# .env asla commit edilmez (kök .gitignore'da).

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bluedev
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# OpenAI (embeddings — text-embedding-3-large)
OPENAI_API_KEY=sk-proj-...

# Anthropic (chat completion — Opus 4.7 / Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-...

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# Supabase JWT (auth)
SUPABASE_JWT_SECRET=dev-secret-change-me-in-production
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
