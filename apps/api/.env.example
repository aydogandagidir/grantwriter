# apps/api environment variables. Pydantic Settings (src/core/config.py)
# auto-loads this file. For real values, copy to .env and fill in. .env is
# gitignored at repo root and never committed.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000"]

# Database / Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bluedev
REDIS_URL=redis://localhost:6379/0
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# LLM providers (BYOK; per-tenant overrides handled in key_vault)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
# LLM_MASTER_ENCRYPTION_KEY=             # 32-byte random key for BYOK pgcrypto envelope

# Embeddings (RAG + distinctiveness scorer)
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# Supabase
# SUPABASE_URL=                          # https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=             # service_role JWT — Storage uploads, never exposed to client
# SUPABASE_STORAGE_BUCKET=exports
SUPABASE_JWT_SECRET=dev-secret-change-me-in-production
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Celery (defaults to REDIS_URL when unset)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Iyzico (TR payments — primary; Stripe deferred to Faz 2)
# IYZICO_API_KEY=                          # public/api key from Iyzico merchant panel
# IYZICO_SECRET_KEY=                       # secret key — used for outbound API auth
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   # prod: https://api.iyzipay.com
# IYZICO_WEBHOOK_SECRET=                   # HMAC secret used to verify inbound webhook signatures
# IYZICO_CALLBACK_URL=https://app.bluedev.dev/billing/return  # post-checkout FE return page

# Observability — both SDKs are optional; init noop when DSN/token unset
# OR the matching package isn't installed (see src/core/observability.py).
# SENTRY_DSN=                              # https://<key>@sentry.io/<project>
# SENTRY_ENVIRONMENT=production            # defaults to APP_ENV
# SENTRY_TRACES_SAMPLE_RATE=0.0            # 0.0 = errors only, 1.0 = full perf
# SENTRY_RELEASE=                          # git SHA at deploy time; lets Sentry group by release (TICKET-003)
# LOGTAIL_TOKEN=                           # source token from Logtail dashboard
# OBSERVABILITY_ENABLED=true               # kill-switch for both

# Email (Resend) — optional; init noop when key/package missing.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Bluedev GrantWriter <noreply@bluedev.dev>"
# APP_URL=https://app.bluedev.dev          # invite accept URLs compose against this origin
# EMAIL_ENABLED=true                        # kill-switch independent of API key

# Test-only: pytest security suite reads TEST_DATABASE_URL when set; the
# RLS edge-case tests skip if it is missing.
# TEST_DATABASE_URL=postgresql://postgres:test@127.0.0.1:55432/postgres
