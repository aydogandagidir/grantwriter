# apps/api production environment template — Sprint 4 Day 16 (Aşama A).
#
# Source of truth: docs/sprint-4-prep.md §1 (canonical secret matrix).
#
# Parser contract (consumed by scripts/preflight-check.sh AND
# tests/test_preflight.py):
#
# - Variables under "# ── REQUIRED ──" are REQUIRED on every production
#   boot. Railway's start command runs preflight-check.sh; any missing
#   REQUIRED var aborts the deploy with a clear list.
# - Variables under "# ── OPTIONAL (kill-switches + tunables) ──" have
#   sensible code defaults; the example documents them but their absence
#   doesn't fail the preflight.
# - Lines starting with "#" or blank lines are ignored.
# - Variable names match `src/core/config.py::Settings` UPPER_SNAKE_CASE.
#
# For local development copy this file to `.env` and fill in real values.
# `.env` is gitignored at the repo root and never committed.

# ── REQUIRED ───────────────────────────────────────────────────────────

# Runtime — pinning to "production" trips the prod code paths
# (Sentry environment defaults to this, etc.)
APP_ENV=production

# LLM providers — platform-managed keys. BYOK tenants override per-tenant
# via the encrypted tenant_llm_config table.
ANTHROPIC_API_KEY=sk-ant-<rotate-via-anthropic-console>
OPENAI_API_KEY=sk-proj-<rotate-via-openai-console>

# Master key for the BYOK pgcrypto envelope. 32 random bytes; rotate
# only via the runbook in infra/supabase/migrations/20260510120000_byok_hardening.sql
# DO NOT REGENERATE WITHOUT THE ROTATION SCRIPT (apps/api/scripts/rotate_master_key.py)
LLM_MASTER_ENCRYPTION_KEY=<openssl rand -base64 32>

# Supabase production project
DATABASE_URL=<copy connection-pooling URL from Supabase dashboard>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT from Supabase Settings → API>
SUPABASE_JWT_SECRET=<JWT secret from Supabase Settings → API>

# Redis — Upstash or Railway Redis add-on. Used for SSE pub-sub,
# rate-limit token buckets, and citation verification cache.
REDIS_URL=<redis-cli rediss:// URL>

# Iyzico (TR payments — primary). Sprint 4 ships prod-merchant integration.
IYZICO_API_KEY=<from Iyzico merchant panel → Settings → API Keys>
IYZICO_SECRET_KEY=<from Iyzico merchant panel → Settings → API Keys>
IYZICO_WEBHOOK_SECRET=<from Iyzico merchant panel → Webhooks → Signature secret>

# Email (Resend transactional)
RESEND_API_KEY=re_<rotate-via-resend-dashboard>

# Observability — Sentry events + Logtail structured logs
SENTRY_DSN=https://<key>@sentry.io/<project>
LOGTAIL_TOKEN=<Better Stack source token>

# Release tag — injected by Railway at deploy time from the git SHA.
# Sentry groups errors by release ("first seen in release X"). Railway
# auto-injects RAILWAY_GIT_COMMIT_SHA; the start command rewrites it as
# SENTRY_RELEASE. Leaving this blank in the example so the start command
# is the single source of truth — preflight skips it.
# (Set automatically: SENTRY_RELEASE=$RAILWAY_GIT_COMMIT_SHA)

# ── OPTIONAL (kill-switches + tunables) ────────────────────────────────

# Iyzico prod endpoint — defaults to sandbox in code so we MUST flip it.
# Listed as optional because the default exists, but the prod deploy
# MUST override.
IYZICO_BASE_URL=https://api.iyzipay.com

# Iyzico hosted-checkout return URL — frontend handles the post-payment
# UX. Update if app.bluedev.dev moves.
IYZICO_CALLBACK_URL=https://app.bluedev.dev/billing/return

# Email composition. EMAIL_FROM MUST match a Resend-verified domain;
# APP_URL is the FE origin used to compose invite accept URLs.
EMAIL_FROM=Bluedev GrantWriter <noreply@bluedev.dev>
APP_URL=https://app.bluedev.dev

# Sentry environment — defaults to APP_ENV. Override only for canary
# deploys or shared staging projects.
SENTRY_ENVIRONMENT=production
# Sentry traces sample rate — 0.0 = errors-only, 1.0 = full perf trace.
# Sprint 4 ships with 5% so we can see hot endpoints without blowing the
# Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0.05

# Kill-switches — set to "false" to disable a subsystem at boot WITHOUT
# rotating the underlying secrets. Useful when an SDK rolls a bad version
# and we need to take it out of the path while we wait for an upstream fix.
OBSERVABILITY_ENABLED=true
EMAIL_ENABLED=true

# Preflight enforcement — when set to "true" / "1" / "yes" / "on", any
# missing REQUIRED var (above) exits the container at boot with a clear
# error in the deploy log. When unset (or anything else), preflight runs
# in WARN-ONLY mode: errors are logged, boot continues. Default is
# warn-only so a phased Sprint 4 rollout (Supabase first, Iyzico/Resend/
# Sentry later) doesn't take down a partially-configured deploy. Flip
# to "true" once every REQUIRED var above is wired (Sprint 4 Aşama D).
PREFLIGHT_STRICT=false

# Logging — INFO is the prod default. Bump to DEBUG only when actively
# triaging an incident; DEBUG ships PII to Logtail.
LOG_LEVEL=INFO

# Database pool — Railway/Supabase quota friendly. Bump if proposals
# generation creates connection pressure.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# CORS origins — frontend(s) allowed to call the API. Add staging /
# preview URLs when those land.
CORS_ORIGINS=["https://app.bluedev.dev"]

# Embeddings — leave at default unless we change the embedding model.
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
