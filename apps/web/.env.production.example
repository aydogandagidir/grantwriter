# apps/web production environment template — Sprint 4 Day 16 (Aşama A).
#
# Source of truth: docs/sprint-4-prep.md §2.
#
# All three variables are NEXT_PUBLIC_* on purpose: they end up in the
# browser bundle and the browser auth client + RSC fetch helpers need
# them at build time. Treat the anon key as "scoped public secret" —
# it's anon-RLS-bound and safe to ship, but rotation still belongs in
# the Supabase dashboard rather than git.
#
# Parser contract: same as apps/api/.env.production.example —
# scripts/preflight-check.sh treats every "# ── REQUIRED ──" entry as
# mandatory.

# ── REQUIRED ───────────────────────────────────────────────────────────

# Supabase production project — paired with the backend's SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key from Supabase Settings → API → anon public. Browser auth
# client + middleware read this. RLS policies in 20260508130200_rls_policies.sql
# protect tenant data even with the key exposed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon JWT from Supabase Settings → API>

# Public backend URL — the frontend hits this for every server-side
# fetch (CSR cookies + tenant scoping live here).
NEXT_PUBLIC_API_URL=https://api.bluedev.dev

# ── OPTIONAL (frontend instrumentation) ────────────────────────────────

# PostHog product analytics — Aşama D wires this once the project key
# exists. Browser bundle only; no server-side PostHog calls.
# NEXT_PUBLIC_POSTHOG_KEY=phc_<from PostHog dashboard>
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
